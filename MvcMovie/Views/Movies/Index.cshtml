@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My Favorite Movies";
}

<h1>My Favorite Movies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-controller="Movies" asp-action="Index" method="get">
    <div style="margin-bottom: 1rem;">
        <label>Genre:
            <select asp-for="MovieGenre" asp-items="Model.Genres" style="padding: 5px;">
                <option value="">All</option>
            </select>
        </label>

        <label>Title:
            <input type="text" asp-for="SearchString" style="padding: 5px;" />
        </label>

        <label>Year:
            <input type="number" asp-for="Year" style="padding: 5px;" min="1900" max="2100"/>
        </label>

        <input type="submit" value="Filter" style="padding: 5px 10px;"/>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Movies![0].Title)</th>
            <th>@Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)</th>
            <th>@Html.DisplayNameFor(model => model.Movies![0].Genre)</th>
            <th>@Html.DisplayNameFor(model => model.Movies![0].Price)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Movies ?? new List<MvcMovie.Models.Movie>())
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.ReleaseDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Genre)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>